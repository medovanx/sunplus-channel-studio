<Window x:Class="SunplusChannelStudio.PlayerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
        Icon="Assets/icon.ico" Width="1024" Height="680" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" Closed="Window_Closed">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Margin="16,10,16,10">
            <ComboBox x:Name="SourceBox" DockPanel.Dock="Right" Width="420" SelectionChanged="SourceBox_SelectionChanged"
                      ToolTip="{DynamicResource Play.SourceTip}" />
            <TextBlock x:Name="SourceLabel" DockPanel.Dock="Right" Text="{DynamicResource Play.Source}"
                       VerticalAlignment="Center" Margin="16,0,8,0" />
            <TextBlock x:Name="ChannelLabel" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>

        <Grid Grid.Row="1" Background="Black">
            <vlc:VideoView x:Name="Video" />
        </Grid>

        <DockPanel Grid.Row="2" Margin="16,8,16,10">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="MuteButton" Padding="12,4" Click="Mute_Click" />
                <Slider x:Name="VolumeSlider" Width="120" Minimum="0" Maximum="100" Value="80" Margin="8,0,0,0"
                        VerticalAlignment="Center" ValueChanged="Volume_Changed" />
            </StackPanel>
            <StackPanel>
                <TextBlock x:Name="StatusLabel" />
                <TextBlock Text="{DynamicResource Play.Notice}" TextWrapping="Wrap" FontSize="11" Margin="0,2,16,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
