<Window x:Class="SunplusChannelStudio.CreateFromWebWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SunplusChannelStudio"
        Title="{DynamicResource New.Title}" Icon="Assets/icon.ico"
        Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="{DynamicResource New.Intro}" TextWrapping="Wrap" Margin="0,0,0,14" />

        <TextBlock Text="{DynamicResource New.Satellite}" Margin="0,0,0,6" />
        <ComboBox x:Name="PositionBox" IsEnabled="False" SelectionChanged="PositionBox_SelectionChanged" />
        <TextBlock x:Name="LoadLabel" Text="{DynamicResource New.Loading}" Margin="0,6,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <TextBlock Text="{DynamicResource New.Format}" Margin="0,14,0,6" />
        <ComboBox x:Name="FormatBox" ToolTip="{DynamicResource Tip.Format}" />

        <TextBlock Text="{DynamicResource New.After}" TextWrapping="Wrap" Margin="0,14,0,0"
                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button x:Name="CreateButton" Padding="18,6" MinWidth="96" IsDefault="True" IsEnabled="False"
                    Style="{DynamicResource AccentButtonStyle}" Click="Create_Click">
                <local:IconLabel Glyph="&#xE710;" Text="{DynamicResource New.Create}" />
            </Button>
            <Button Padding="18,6" MinWidth="96" Margin="8,0,0,0" IsCancel="True">
                <local:IconLabel Glyph="&#xE711;" Text="{DynamicResource Dlg.Cancel}" />
            </Button>
        </StackPanel>
    </StackPanel>
</Window>
