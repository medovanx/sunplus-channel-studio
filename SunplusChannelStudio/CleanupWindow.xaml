<Window x:Class="SunplusChannelStudio.CleanupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Cln.Title}" Icon="Assets/icon.ico"
        Width="960" Height="640" MinWidth="720" MinHeight="420"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Cln.Intro}" TextWrapping="Wrap" />

        <WrapPanel Grid.Row="1" Margin="0,12,0,10">
            <CheckBox x:Name="ScrambledBox" Content="{DynamicResource Cln.Scrambled}" IsChecked="True"
                      ToolTip="{DynamicResource Cln.ScrambledTip}" Margin="0,0,24,4" Click="Category_Click" />
            <CheckBox x:Name="PlaceholderBox" Content="{DynamicResource Cln.Placeholder}" IsChecked="True"
                      ToolTip="{DynamicResource Cln.PlaceholderTip}" Margin="0,0,24,4" Click="Category_Click" />
            <CheckBox x:Name="NoStreamsBox" Content="{DynamicResource Cln.NoStreams}" IsChecked="True"
                      ToolTip="{DynamicResource Cln.NoStreamsTip}" Margin="0,0,24,4" Click="Category_Click" />
            <CheckBox x:Name="DuplicateBox" Content="{DynamicResource Cln.Duplicate}" IsChecked="True"
                      ToolTip="{DynamicResource Cln.DuplicateTip}" Margin="0,0,24,4" Click="Category_Click" />
        </WrapPanel>

        <Grid Grid.Row="2">
            <DataGrid x:Name="ItemsGrid" AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                      CanUserReorderColumns="False" HeadersVisibility="Column" GridLinesVisibility="None"
                      SelectionMode="Extended" />
            <TextBlock x:Name="Nothing" Text="{DynamicResource Cln.Nothing}" Visibility="Collapsed"
                       HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,14,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="RemoveButton" Content="{DynamicResource Cln.Remove}" Padding="18,6" MinWidth="96"
                        IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Remove_Click" />
                <Button Content="{DynamicResource Dlg.Cancel}" Padding="18,6" MinWidth="96" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Button Content="{DynamicResource Imp.SelectAll}" Padding="12,5" Click="SelectAll_Click" />
                <Button Content="{DynamicResource Imp.SelectNone}" Padding="12,5" Margin="6,0,0,0" Click="SelectNone_Click" />
                <TextBlock x:Name="CountLabel" VerticalAlignment="Center" Margin="14,0,0,0"
                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
