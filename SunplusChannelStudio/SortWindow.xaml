<Window x:Class="SunplusChannelStudio.SortWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SunplusChannelStudio"
        Title="{DynamicResource Sort.Title}" Icon="Assets/icon.ico"
        Width="560" Height="600" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="20,16,20,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="{DynamicResource Sort.Intro}" TextWrapping="Wrap" Margin="0,0,0,12" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ListBox x:Name="CategoryList" SelectionMode="Single" />
            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                <Button x:Name="UpButton" Click="Up_Click" ToolTip="{DynamicResource Tip.Up}" HorizontalAlignment="Stretch" Padding="12,6">
                    <local:IconLabel Glyph="&#xE74A;" Text="{DynamicResource Btn.Up}" />
                </Button>
                <Button x:Name="DownButton" Click="Down_Click" ToolTip="{DynamicResource Tip.Down}" HorizontalAlignment="Stretch" Padding="12,6" Margin="0,6,0,0">
                    <local:IconLabel Glyph="&#xE74B;" Text="{DynamicResource Btn.Down}" />
                </Button>
                <Button Click="Reset_Click" HorizontalAlignment="Stretch" Padding="12,6" Margin="0,18,0,0" ToolTip="{DynamicResource Sort.ResetTip}">
                    <local:IconLabel Glyph="&#xE777;" Text="{DynamicResource Sort.Reset}" />
                </Button>
            </StackPanel>
        </Grid>

        <StackPanel Grid.Row="2" Margin="0,12,0,0">
            <CheckBox x:Name="AlphabeticalBox" Content="{DynamicResource Sort.Alphabetical}" />
            <CheckBox x:Name="RadioBox" Content="{DynamicResource Sort.AlsoRadio}" Margin="0,6,0,0" />
        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Padding="18,6" MinWidth="96" IsDefault="True" Style="{DynamicResource AccentButtonStyle}" Click="Apply_Click">
                <local:IconLabel Glyph="&#xE8CB;" Text="{DynamicResource Sort.Apply}" />
            </Button>
            <Button Padding="18,6" MinWidth="96" Margin="8,0,0,0" IsCancel="True">
                <local:IconLabel Glyph="&#xE711;" Text="{DynamicResource Dlg.Cancel}" />
            </Button>
        </StackPanel>
    </Grid>
</Window>
