<Window x:Class="SunplusChannelStudio.LiveTvWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SunplusChannelStudio"
        Title="{DynamicResource Live.Title}" Icon="Assets/icon.ico"
        Width="900" Height="640" MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner">
    <Grid Margin="16,12,16,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel>
            <Button x:Name="WatchButton" DockPanel.Dock="Right" Padding="12,6" Margin="10,0,0,0" IsEnabled="False"
                    Style="{DynamicResource AccentButtonStyle}" Click="Watch_Click" ToolTip="{DynamicResource Live.WatchTip}">
                <local:IconLabel Glyph="&#xE768;" Text="{DynamicResource Btn.Watch}" />
            </Button>
            <ComboBox x:Name="CategoryBox" DockPanel.Dock="Right" Width="150" Margin="10,0,0,0" IsEnabled="False"
                      SelectionChanged="Filter_Changed" ToolTip="{DynamicResource Live.CategoryTip}" />
            <ComboBox x:Name="CountryBox" DockPanel.Dock="Right" Width="200" Margin="10,0,0,0" IsEnabled="False"
                      SelectionChanged="Filter_Changed" ToolTip="{DynamicResource Live.CountryTip}" />
            <TextBox x:Name="SearchBox" IsEnabled="False" TextChanged="SearchBox_TextChanged" ToolTip="{DynamicResource Live.SearchTip}" />
        </DockPanel>

        <DataGrid x:Name="ChannelGrid" Grid.Row="1" Margin="0,10,0,0" AutoGenerateColumns="False" IsReadOnly="True"
                  CanUserAddRows="False" CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                  GridLinesVisibility="None" SelectionMode="Single" SelectionUnit="FullRow"
                  EnableRowVirtualization="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  MouseDoubleClick="ChannelGrid_MouseDoubleClick" KeyDown="ChannelGrid_KeyDown" SelectionChanged="ChannelGrid_SelectionChanged">
            <DataGrid.CellStyle>
                <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                    <Setter Property="BorderThickness" Value="0" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                </Style>
            </DataGrid.CellStyle>
        </DataGrid>

        <!-- Shown over the empty grid while the list loads or when nothing matches. -->
        <StackPanel x:Name="Placeholder" Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <ProgressBar x:Name="LoadingBar" IsIndeterminate="True" Width="220" Margin="0,0,0,10" />
            <TextBlock x:Name="PlaceholderText" Text="{DynamicResource Live.Loading}" TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </StackPanel>

        <DockPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock x:Name="CountLabel" DockPanel.Dock="Right" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
            <TextBlock Text="{DynamicResource Play.Notice}" TextWrapping="Wrap" FontSize="11" Margin="0,0,16,0"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
        </DockPanel>
    </Grid>
</Window>
