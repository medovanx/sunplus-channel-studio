<Window x:Class="SunplusChannelStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:SunplusChannelStudio"
        Title="Sunplus Channel Studio" Icon="Assets/icon.ico" Width="1400" Height="820" MinWidth="900" MinHeight="520"
        WindowStartupLocation="CenterScreen" AllowDrop="True"
        Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="ApplicationCommands.Open" />
        <KeyBinding Key="S" Modifiers="Control" Command="ApplicationCommands.Save" />
        <KeyBinding Key="S" Modifiers="Control+Shift" Command="ApplicationCommands.SaveAs" />
        <KeyBinding Key="F" Modifiers="Control" Command="ApplicationCommands.Find" />
        <KeyBinding Key="Z" Modifiers="Control" Command="ApplicationCommands.Undo" />
        <KeyBinding Key="Y" Modifiers="Control" Command="ApplicationCommands.Redo" />
        <KeyBinding Key="Z" Modifiers="Control+Shift" Command="ApplicationCommands.Redo" />
    </Window.InputBindings>
    <Window.CommandBindings>
        <CommandBinding Command="ApplicationCommands.Open" Executed="Open_Executed" />
        <CommandBinding Command="ApplicationCommands.Save" Executed="Save_Executed" CanExecute="HasFile_CanExecute" />
        <CommandBinding Command="ApplicationCommands.SaveAs" Executed="SaveAs_Executed" CanExecute="HasFile_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Find" Executed="Find_Executed" />
        <CommandBinding Command="ApplicationCommands.Undo" Executed="Undo_Executed" CanExecute="Undo_CanExecute" />
        <CommandBinding Command="ApplicationCommands.Redo" Executed="Redo_Executed" CanExecute="Redo_CanExecute" />
        <CommandBinding Command="local:AppCommands.Revert" Executed="Revert_Executed" CanExecute="Revert_CanExecute" />
    </Window.CommandBindings>

    <Window.Resources>
        <ContextMenu x:Key="ChannelMenu" Opened="ChannelMenu_Opened">
            <MenuItem Header="{DynamicResource Menu.Watch}" InputGestureText="Ctrl+Enter" Click="Watch_Click" Tag="Watch" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu.Rename}" InputGestureText="F2" Click="Rename_Click" />
            <MenuItem Header="{DynamicResource Menu.FavoriteGroup}" Tag="Favorites" />
            <MenuItem Header="{DynamicResource Menu.Category}" Tag="Categories" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu.MoveUp}" InputGestureText="Ctrl+Up" Click="MoveUp_Click" />
            <MenuItem Header="{DynamicResource Menu.MoveDown}" InputGestureText="Ctrl+Down" Click="MoveDown_Click" />
            <MenuItem Header="{DynamicResource Menu.MoveTo}" InputGestureText="Ctrl+M" Click="MoveTo_Click" />
            <Separator />
            <MenuItem Header="{DynamicResource Menu.Delete}" InputGestureText="Del" Click="Delete_Click" />
        </ContextMenu>

        <Style x:Key="ChannelGrid" TargetType="DataGrid" BasedOn="{StaticResource {x:Type DataGrid}}">
            <Setter Property="AutoGenerateColumns" Value="False" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="CanUserSortColumns" Value="True" />
            <Setter Property="CanUserReorderColumns" Value="False" />
            <Setter Property="SelectionMode" Value="Extended" />
            <Setter Property="SelectionUnit" Value="FullRow" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="GridLinesVisibility" Value="None" />
            <Setter Property="EnableRowVirtualization" Value="True" />
            <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
            <Setter Property="AllowDrop" Value="True" />
            <Setter Property="ContextMenu" Value="{StaticResource ChannelMenu}" />
            <!-- Rows select as a whole, so the focused cell gets no outline of its own. -->
            <Setter Property="CellStyle">
                <Setter.Value>
                    <Style TargetType="DataGridCell" BasedOn="{StaticResource {x:Type DataGridCell}}">
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Dim" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Toolbar -->
        <Border Grid.Row="0" Padding="12,10" BorderThickness="0,0,0,1"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <Button Command="ApplicationCommands.Open" Padding="14,6" ToolTip="{DynamicResource Tip.Open}">
                <local:IconLabel Glyph="&#xE8E5;" Text="{DynamicResource Btn.Open}" />
            </Button>
                    <Button Command="ApplicationCommands.Save" Padding="14,6" Margin="6,0,0,0" ToolTip="{DynamicResource Tip.Save}"
                            Style="{DynamicResource AccentButtonStyle}">
                <local:IconLabel Glyph="&#xE74E;" Text="{DynamicResource Btn.Save}" />
            </Button>
                    <Button Command="ApplicationCommands.SaveAs" Padding="14,6" Margin="6,0,0,0"
                            ToolTip="{DynamicResource Tip.SaveAs}">
                <local:IconLabel Glyph="&#xE792;" Text="{DynamicResource Btn.SaveAs}" />
            </Button>
                    <Button Command="ApplicationCommands.Undo" Padding="14,6" Margin="6,0,0,0"
                            ToolTip="{DynamicResource Tip.Undo}">
                <local:IconLabel Glyph="&#xE7A7;" Text="{DynamicResource Btn.Undo}" />
            </Button>
                    <Button Command="ApplicationCommands.Redo" Padding="14,6" Margin="6,0,0,0"
                            ToolTip="{DynamicResource Tip.Redo}">
                <local:IconLabel Glyph="&#xE7A6;" Text="{DynamicResource Btn.Redo}" />
            </Button>
                    <Button Command="local:AppCommands.Revert" Padding="14,6" Margin="6,0,0,0"
                            ToolTip="{DynamicResource Tip.Revert}">
                <local:IconLabel Glyph="&#xE777;" Text="{DynamicResource Btn.Revert}" />
            </Button>
                    <Button x:Name="ImportButton" Padding="14,6" Margin="6,0,0,0" IsEnabled="False" Click="Import_Click"
                            ToolTip="{DynamicResource Tip.Import}">
                <local:IconLabel Glyph="&#xE8B5;" Text="{DynamicResource Btn.Import}" />
            </Button>
                    <Button x:Name="CleanupButton" Padding="14,6" Margin="6,0,0,0" IsEnabled="False" Click="Cleanup_Click"
                            ToolTip="{DynamicResource Tip.Cleanup}">
                <local:IconLabel Glyph="&#xEA99;" Text="{DynamicResource Btn.Cleanup}" />
            </Button>
                    <Button Padding="14,6" Margin="6,0,0,0" Click="LiveTv_Click" ToolTip="{DynamicResource Tip.LiveTv}">
                        <local:IconLabel Glyph="&#xE7F4;" Text="{DynamicResource Btn.LiveTv}" />
                    </Button>
                    <TextBlock Text="{DynamicResource Lbl.Format}" VerticalAlignment="Center" Margin="18,0,8,0" Style="{StaticResource Dim}" />
                    <ComboBox x:Name="FormatBox" Width="170" IsEnabled="False" SelectionChanged="FormatBox_SelectionChanged"
                              ToolTip="{DynamicResource Tip.Format}" />
                </StackPanel>
                <Button x:Name="LanguageButton" DockPanel.Dock="Right" Padding="12,6" Margin="16,0,0,0"
                        Click="LanguageButton_Click" ToolTip="{DynamicResource Tip.Language}" />
                <TextBlock x:Name="FileLabel" FlowDirection="LeftToRight" VerticalAlignment="Center" HorizontalAlignment="Right"
                           TextTrimming="CharacterEllipsis" Margin="16,0,0,0" Style="{StaticResource Dim}" />
            </DockPanel>
        </Border>

        <!-- Empty state -->
        <Grid x:Name="EmptyState" Grid.Row="1">
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420">
                <Image Source="Assets/icon.png" Width="96" Height="96" Margin="0,0,0,18" />
                <TextBlock Text="{DynamicResource Empty.Title}" FontSize="24" FontWeight="SemiBold" HorizontalAlignment="Center" />
                <TextBlock Margin="0,8,0,18" TextWrapping="Wrap" TextAlignment="Center" Style="{StaticResource Dim}"
                           Text="{DynamicResource Empty.Body}" />
                <!-- One column as wide as the widest button, so all three match in any language. -->
                <StackPanel HorizontalAlignment="Center">
                    <Button Command="ApplicationCommands.Open" HorizontalAlignment="Stretch" Padding="22,8"
                            Style="{DynamicResource AccentButtonStyle}">
                        <local:IconLabel Glyph="&#xE8E5;" Text="{DynamicResource Empty.Open}" />
                    </Button>
                    <Button Click="CreateFromWeb_Click" HorizontalAlignment="Stretch" Padding="22,8" Margin="0,10,0,0"
                            ToolTip="{DynamicResource New.Tip}">
                        <local:IconLabel Glyph="&#xE753;" Text="{DynamicResource New.Button}" />
                    </Button>
                    <Button Click="LiveTv_Click" HorizontalAlignment="Stretch" Padding="22,8" Margin="0,10,0,0"
                            ToolTip="{DynamicResource Tip.LiveTv}">
                        <local:IconLabel Glyph="&#xE7F4;" Text="{DynamicResource Btn.LiveTv}" />
                    </Button>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Editor -->
        <Grid x:Name="Editor" Grid.Row="1" Visibility="Collapsed">
        <TabControl x:Name="Tabs" Margin="8,6,8,0" SelectionChanged="Tabs_SelectionChanged">
            <TabItem x:Name="TvTab">
                <DataGrid x:Name="TvGrid" Margin="0,8,0,0" Style="{StaticResource ChannelGrid}" />
            </TabItem>
            <TabItem x:Name="RadioTab">
                <DataGrid x:Name="RadioGrid" Margin="0,8,0,0" Style="{StaticResource ChannelGrid}" />
            </TabItem>
            <TabItem x:Name="TpTab">
                <DataGrid x:Name="TpGrid" Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="None" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Col.Number" Binding="{Binding Index}" IsReadOnly="True" Width="60" />
                        <DataGridTextColumn Header="Col.TpName" Width="200"
                                            Binding="{Binding Name, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="Col.Frequency" Width="140"
                                            Binding="{Binding Frequency, ValidatesOnExceptions=True}" />
                        <DataGridTemplateColumn Header="Col.Polarization" Width="140">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Polarization}" VerticalAlignment="Center" Margin="8,0,12,0" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                            <DataGridTemplateColumn.CellEditingTemplate>
                                <DataTemplate>
                                    <ComboBox ItemsSource="{x:Static local:TransponderRow.Polarizations}"
                                              SelectedItem="{Binding Polarization, UpdateSourceTrigger=PropertyChanged}" />
                                </DataTemplate>
                            </DataGridTemplateColumn.CellEditingTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Col.SymbolRate" Width="150"
                                            Binding="{Binding SymbolRate, ValidatesOnExceptions=True}" />
                        <DataGridTextColumn Header="Col.Satellite" Binding="{Binding Satellite}" IsReadOnly="True" Width="*" />
                        <DataGridTextColumn Header="Col.Channels" Binding="{Binding Channels}" IsReadOnly="True" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
            <TabItem x:Name="SatTab">
                <DataGrid x:Name="SatGrid" Margin="0,8,0,0" AutoGenerateColumns="False" CanUserAddRows="False"
                          CanUserDeleteRows="False" CanUserReorderColumns="False" HeadersVisibility="Column"
                          GridLinesVisibility="None" SelectionMode="Single">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Col.Number" Binding="{Binding Index}" IsReadOnly="True" Width="60" />
                        <DataGridTextColumn Header="Col.SatName" Width="260"
                                            Binding="{Binding Name, ValidatesOnExceptions=True, UpdateSourceTrigger=LostFocus}" />
                        <DataGridTextColumn Header="Col.Position" Binding="{Binding Position}" IsReadOnly="True" Width="120" />
                        <DataGridTextColumn Header="Col.Lnb" Binding="{Binding Lnb}" IsReadOnly="True" Width="200" />
                        <DataGridTextColumn Header="Col.Transponders" Binding="{Binding Transponders}" IsReadOnly="True" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>

        <!-- Channel actions, shown on the TV and Radio tabs; sits on the tab strip's right side. -->
        <StackPanel x:Name="ChannelBar" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,12,0">
            <Grid Width="240">
                <TextBox x:Name="SearchBox" TextChanged="SearchBox_TextChanged" ToolTip="{DynamicResource Tip.Search}" />
                <TextBlock Text="{DynamicResource Search.Placeholder}" IsHitTestVisible="False" Margin="12,0,0,0" VerticalAlignment="Center"
                           Style="{StaticResource Dim}">
                    <TextBlock.Visibility>
                        <Binding ElementName="SearchBox" Path="Text.IsEmpty">
                            <Binding.Converter><BooleanToVisibilityConverter /></Binding.Converter>
                        </Binding>
                    </TextBlock.Visibility>
                </TextBlock>
            </Grid>
            <Button x:Name="WatchButton" Margin="10,0,0,0" Padding="10,5" Click="Watch_Click"
                    ToolTip="{DynamicResource Tip.Watch}" ToolTipService.ShowOnDisabled="True">
                <local:IconLabel Glyph="&#xE768;" Text="{DynamicResource Btn.Watch}" />
            </Button>
            <Button x:Name="SortButton" Margin="4,0,0,0" Padding="10,5" Click="Sort_Click" ToolTip="{DynamicResource Tip.Sort}">
                <local:IconLabel Glyph="&#xE8CB;" Text="{DynamicResource Btn.Sort}" />
            </Button>
            <Button x:Name="UpButton" Margin="10,0,0,0" Padding="10,5" Click="MoveUp_Click" ToolTip="{DynamicResource Tip.Up}">
                <local:IconLabel Glyph="&#xE74A;" Text="{DynamicResource Btn.Up}" />
            </Button>
            <Button x:Name="DownButton" Margin="4,0,0,0" Padding="10,5" Click="MoveDown_Click" ToolTip="{DynamicResource Tip.Down}">
                <local:IconLabel Glyph="&#xE74B;" Text="{DynamicResource Btn.Down}" />
            </Button>
            <Button x:Name="MoveToButton" Margin="4,0,0,0" Padding="10,5" Click="MoveTo_Click" ToolTip="{DynamicResource Tip.MoveTo}">
                <local:IconLabel Glyph="&#xE8AB;" Text="{DynamicResource Btn.MoveTo}" />
            </Button>
            <Button x:Name="FavoriteButton" Margin="4,0,0,0" Padding="10,5" Click="FavoriteButton_Click"
                    ToolTip="{DynamicResource Tip.Favorite}">
                <local:IconLabel Glyph="&#xE734;" Text="{DynamicResource Btn.Favorite}" />
            </Button>
            <Button x:Name="DeleteButton" Margin="4,0,0,0" Padding="10,5" Click="Delete_Click" ToolTip="{DynamicResource Tip.Delete}">
                <local:IconLabel Glyph="&#xE74D;" Text="{DynamicResource Btn.Delete}" />
            </Button>
        </StackPanel>
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Padding="14,6" BorderThickness="0,1,0,0"
                BorderBrush="{DynamicResource DividerStrokeColorDefaultBrush}">
            <DockPanel>
                <TextBlock x:Name="DirtyLabel" DockPanel.Dock="Right" Text="{DynamicResource Status.Unsaved}" Visibility="Collapsed"
                           Foreground="{DynamicResource SystemFillColorCautionBrush}" />
                <TextBlock x:Name="StatusLabel" Style="{StaticResource Dim}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
